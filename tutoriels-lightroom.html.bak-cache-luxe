<style>
/* Menu mobile */
.menu-toggle {
  display: none; width: 42px; height: 42px; border: 1px solid rgba(224,189,133,0.4);
  background: rgba(224,189,133,0.06); color: var(--accent); cursor: pointer;
  border-radius: 2px; font-size: 1.2rem; line-height: 1;
}
@media (max-width: 780px) {
  .menu-toggle { display: flex; align-items: center; justify-content: center; }
  nav {
    position: fixed; top: 72px; left: 0; right: 0; min-height: calc(100dvh - 72px);
    flex-direction: column; align-items: stretch; gap: 0;
    background: #08070a; border-bottom: 1px solid rgba(224,189,133,0.2);
    padding: 10px 20px 20px; transform: translateY(-150%); opacity: 0;
    transition: transform 0.35s ease, opacity 0.3s; z-index: 9000;
  }
  nav.open { transform: translateY(0); opacity: 1; }
  nav a { display: block; padding: 13px 4px; border-bottom: 1px solid rgba(255,255,255,0.05); }
  .admin-btn { margin: 14px 0 0; width: 100%; }
}

/* Filtres de catégories */
.course-filters-wrap {
  text-align: center; margin: 10px auto 50px; max-width: 100%;
}
.course-filters {
  display: flex; flex-wrap: nowrap; gap: 12px; justify-content: center;
}
.filter-btn {
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(224,189,133,0.22);
  color: var(--text);
  padding: 13px 16px;
  border-radius: 30px;
  font-family: "Montserrat", sans-serif;
  font-size: 0.74rem;
  letter-spacing: 0.6px;
  cursor: pointer;
  transition: all 0.3s ease;
  display: inline-flex; align-items: center; justify-content: center; gap: 7px;
  text-decoration: none; white-space: nowrap; flex: 0 0 auto;
}
@media (max-width: 900px) {
  .course-filters { flex-wrap: wrap; }
}
.filter-btn:hover {
  border-color: var(--accent); background: rgba(224,189,133,0.1);
  transform: translateY(-2px);
}
.filter-btn.active {
  background: var(--accent); color: #000; font-weight: 600;
  border-color: var(--accent);
  box-shadow: 0 4px 18px rgba(224,189,133,0.35);
  transform: translateY(-2px);
}
.badge-tag {
  font-size: 0.65rem; font-weight: 700; padding: 2px 7px;
  border-radius: 12px; letter-spacing: 0.5px;
}
.lr-tag { background: #001e36; color: #38a9ff; border: 1px solid #38a9ff55; }
.c1-tag { background: #2b1100; color: #ff9d42; border: 1px solid #ff9d4255; }
.strobe-tag { background: #261e05; color: #ffd15c; border: 1px solid #ffd15c55; }
.basics-tag { background: #1a1a24; color: #bca4f5; border: 1px solid #bca4f555; }
.filter-btn.active .badge-tag {
  background: rgba(0,0,0,0.25); color: #000; border-color: rgba(0,0,0,0.3);
}

/* En-tête de catégorie */
.cat-divider {
  display: flex; align-items: center; gap: 16px; margin: 55px auto 20px;
  max-width: 1000px;
}
.cat-divider h2 {
  font-family: "Cormorant Garamond", serif; font-size: 2rem;
  color: var(--accent); margin: 0; white-space: nowrap; display: flex; align-items: center; gap: 12px;
}
.cat-divider .line {
  flex: 1; height: 1px; background: linear-gradient(90deg, rgba(224,189,133,0.4), transparent);
}
.cat-desc {
  max-width: 1000px; margin: 0 auto 30px; color: var(--muted); font-size: 0.95rem; line-height: 1.7;
}

/* Accordéon glissant ultra-fluide */
.cours-section {
  max-width: 1000px; margin: 0 auto 16px;
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(224,189,133,0.18);
  border-radius: 4px;
  transition: border-color 0.35s, box-shadow 0.35s, background 0.35s;
  overflow: hidden;
}
.cours-section:hover {
  border-color: rgba(224,189,133,0.45);
  box-shadow: 0 8px 30px rgba(0,0,0,0.35);
}
.cours-section.open {
  border-color: rgba(224,189,133,0.7);
  background: rgba(255,255,255,0.035);
  box-shadow: 0 16px 50px rgba(0,0,0,0.55), 0 0 25px rgba(224,189,133,0.15);
}
.cours-section-head {
  padding: 22px 28px;
  display: flex; align-items: center; gap: 20px;
  cursor: pointer; user-select: none;
  background: rgba(255,255,255,0.01);
  transition: background 0.3s;
}
.cours-section-head:hover {
  background: rgba(224,189,133,0.04);
}
@media (max-width: 600px) {
  .cours-section-head {
    padding: 16px 18px; gap: 14px; flex-wrap: wrap;
  }
}
.cours-num {
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: 2.2rem; font-weight: 300; line-height: 1;
  color: var(--accent); flex: none;
}
.cours-kicker {
  font-family: "Montserrat", sans-serif; font-size: 0.65rem;
  letter-spacing: 2px; text-transform: uppercase; color: var(--muted);
  margin-bottom: 4px;
}
.cours-section-head h3 {
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: 1.45rem; font-weight: 400; color: #fff; margin: 0;
  line-height: 1.25;
}
.cours-badge {
  font-family: "Montserrat", sans-serif; font-size: 0.65rem;
  letter-spacing: 1px; text-transform: uppercase;
  padding: 4px 10px; border-radius: 12px;
  background: rgba(224,189,133,0.08); border: 1px solid rgba(224,189,133,0.3);
  color: var(--accent); flex: none; margin-left: 10px;
}
@media (max-width: 700px) {
  .cours-badge { display: none; }
}

.cours-toggle-btn {
  margin-left: auto;
  display: inline-flex; align-items: center; gap: 8px;
  padding: 7px 16px; border-radius: 20px;
  border: 1px solid rgba(224,189,133,0.35);
  background: rgba(224,189,133,0.06);
  color: var(--accent); font-family: "Montserrat", sans-serif;
  font-size: 0.72rem; letter-spacing: 1px; text-transform: uppercase;
  transition: all 0.3s ease;
  flex: none;
}
.cours-section.open .cours-toggle-btn {
  background: var(--accent); color: #0b0b0d; font-weight: 600;
  border-color: var(--accent);
}
.cours-toggle-arrow {
  display: inline-block; font-size: 0.75rem;
  transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}
.cours-section.open .cours-toggle-arrow {
  transform: rotate(180deg);
}

/* Le tiroir glissant (CSS Grid 0fr -> 1fr) */
.cours-accordion-drawer {
  display: grid !important;
  grid-template-rows: 0fr !important;
  transition: grid-template-rows 0.48s cubic-bezier(0.25, 1, 0.5, 1) !important;
}
.cours-section.open .cours-accordion-drawer {
  grid-template-rows: 1fr !important;
}
.cours-accordion-inner {
  overflow: hidden !important;
  min-height: 0 !important;
  opacity: 0;
  transform: translateY(-12px);
  transition: opacity 0.38s ease 0.1s, transform 0.38s ease 0.1s;
}
.cours-section.open .cours-accordion-inner {
  opacity: 1;
  transform: translateY(0);
}
.cours-body {
  display: block !important;
  padding: 16px 30px 34px !important;
  border-top: 1px solid rgba(224,189,133,0.12);
  margin-top: 0 !important;
}
@media (max-width: 600px) {
  .cours-body { padding: 14px 18px 26px !important; }
}

.reglages-table { margin: 18px 0 8px; }
.reglages-table img { width: 100%; max-width: 720px; height: auto; display: block; border: 1px solid rgba(224,189,133,0.25); border-radius: 4px; }
.cours-lead {
  color: var(--accent-2); font-size: 1.05rem; line-height: 1.7;
  margin-bottom: 20px; font-style: italic; font-family: "Cormorant Garamond", serif;
}

/* Texte explicatif riche */
.cours-expl-text {
  color: #d6d3ce; font-size: 0.95rem; line-height: 1.85; margin: 20px 0 25px;
}
.cours-expl-text p { margin-bottom: 14px; }
.cours-expl-text strong { color: #fff; font-weight: 600; }
.cours-expl-text em { color: var(--accent-2); font-style: normal; }

.cours-expl-highlight {
  border-left: 3px solid var(--accent);
  background: rgba(224,189,133,0.05);
  padding: 14px 20px; margin: 18px 0; border-radius: 0 4px 4px 0;
  font-size: 0.92rem; color: #f0ebe1;
}

/* Raccourcis et Astuces studio */
.shortcut-box {
  background: rgba(224,189,133,0.04);
  border-left: 3px solid var(--accent);
  padding: 14px 18px; margin: 18px 0; border-radius: 0 4px 4px 0;
  font-size: 0.88rem; color: #e8e6e3;
}
.shortcut-box strong { color: var(--accent); display: block; margin-bottom: 6px; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 1px; }
.shortcut-box kbd {
  background: rgba(255,255,255,0.1); border: 1px solid rgba(224,189,133,0.35);
  color: var(--accent); padding: 2px 7px; border-radius: 3px;
  font-family: monospace; font-size: 0.82rem; margin: 0 2px;
}
.tip-box {
  background: rgba(142,68,173,0.09);
  border: 1px dashed rgba(188,164,245,0.38);
  padding: 14px 18px; margin: 18px 0; border-radius: 4px;
  font-size: 0.88rem; color: #ded4f5;
}
.tip-box strong { color: #caa6ff; display: block; margin-bottom: 6px; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 1px; }

/* Bloc Vidéo pédagogique */
.cours-video {
  margin: 26px 0 20px;
  background: rgba(0,0,0,0.4);
  border: 1px solid rgba(224,189,133,0.25);
  padding: 18px;
  border-radius: 4px;
}
.cours-video-label {
  font-family: "Montserrat", sans-serif; font-size: 0.65rem;
  letter-spacing: 3px; text-transform: uppercase; color: var(--accent);
  margin-bottom: 12px; display: flex; align-items: center; gap: 10px; font-weight: 600;
}
.cours-video-label::before {
  content: ''; width: 20px; height: 2px; background: var(--accent);
}
.cours-video-frame {
  position: relative; width: 100%; max-width: 800px;
  aspect-ratio: 16 / 9; background: #000;
  border: 1px solid rgba(224,189,133,0.2); overflow: hidden;
  border-radius: 3px; margin-bottom: 12px;
}
.cours-video-frame iframe {
  position: absolute; inset: 0; width: 100%; height: 100%; border: 0;
}
.cours-video-lazy {
  position: absolute; inset: 0; width: 100%; border: 0; cursor: pointer;
  background: #08070a center / cover no-repeat;
  color: #fff; display: flex; align-items: center; justify-content: center;
  text-decoration: none;
}
.cours-video-play {
  width: 72px; height: 72px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: rgba(224,189,133,.94); color: #09090b;
  box-shadow: 0 10px 35px rgba(0,0,0,.55);
  transition: transform .25s ease, background .25s ease;
}
.cours-video-lazy:hover .cours-video-play {
  transform: scale(1.08); background: #fff0be;
}
.cours-video-play span {
  margin-left: 5px; font-size: 1.45rem; line-height: 1;
}
.cours-video-caption {
  color: var(--muted); font-size: 0.85rem; line-height: 1.6;
}
.cours-video-caption a {
  color: var(--accent); text-decoration: underline; margin-left: 6px;
}
.video-key-points {
  margin-top: 10px; padding-top: 10px; border-top: 1px solid rgba(255,255,255,0.06);
  font-size: 0.82rem; color: #ccc;
}
.video-key-points strong { color: var(--accent-2); }

/* Filtres Masquage */
.cours-section.filtered-out, .cat-group.filtered-out {
  display: none !important;
}
/* ---------- CONTROLES PERSISTANTS (hors intro) ---------- */
  .site-controls { position: fixed; top: 18px; right: 18px; z-index: 10000; display: flex; gap: 8px; }
  .site-controls button {
    width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center;
    background: rgba(8,7,10,0.72); border: 1px solid rgba(224,189,133,0.45);
    color: var(--accent); font-size: 1rem; cursor: pointer; backdrop-filter: blur(8px);
    transition: background 0.25s, color 0.25s, transform 0.25s;
  }
  .site-controls button:hover { background: var(--accent); color: var(--bg); transform: translateY(-1px); }

  /* ---------- PETITS AJUSTEMENTS PAGE D'ACCUEIL ---------- */
  main { padding-top: 72px; }
  #portfolio { padding: 90px 0 20px; }
  .about-wrap { padding-bottom: 10px; }
  #contact { padding-bottom: 90px; }
  /* ---------- MENU MOBILE ---------- */
  .menu-toggle { display: none; width: 42px; height: 42px; border: 1px solid rgba(224,189,133,0.4); background: rgba(224,189,133,0.06); color: var(--accent); cursor: pointer; border-radius: 2px; font-size: 1.2rem; line-height: 1; }
  @media (max-width: 780px) {
    .menu-toggle { display: flex; align-items: center; justify-content: center; }
    nav {
      position: fixed; top: 72px; left: 0; right: 0; min-height: calc(100dvh - 72px);
      flex-direction: column; align-items: stretch; gap: 0;
      background: #08070a; border-bottom: 1px solid rgba(224,189,133,0.2);
      padding: 10px 20px 20px; transform: translateY(-150%); opacity: 0;
      transition: transform 0.35s ease, opacity 0.3s; z-index: 9000;
    }
    nav.open { transform: translateY(0); opacity: 1; }
    nav a { display: block; padding: 13px 4px; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .admin-btn { margin: 14px 0 0; width: 100%; }
  }

  @media (max-width: 760px) {
    .intro-frame { display: none; }
    .site-controls { top: 12px; right: 12px; }
    .site-controls button { width: 38px; height: 38px; }
  }
  @media (max-width: 600px) {
    .logo { font-size: 0.95rem; letter-spacing: 3px; }
    .logo::before { width: 16px; }
    .logo span { display: none; }
    .site-controls { top: auto; bottom: 16px; right: 12px; }
    .site-controls svg { width: 15px; height: 15px; }
    .nav { height: 64px; }
    header .admin-btn { padding: 8px 14px; }
  }


/* ===== FOND STUDIO SEMI-FLOUTE (section A propos) ===== */
#apropos { position: relative; overflow: hidden; }
#apropos::before {
  content: ''; position: absolute; inset: 0; z-index: 0;
  background-image: url('studio-hero.jpg');
  background-size: cover; background-position: center;
  filter: blur(9px) brightness(0.5) saturate(0.85);
  transform: scale(1.08); pointer-events: none;
}
#apropos::after {
  content: ''; position: absolute; inset: 0; z-index: 0;
  background: linear-gradient(180deg, rgba(8,7,10,0.82) 0%, rgba(8,7,10,0.88) 55%, rgba(8,7,10,0.96) 100%);
  pointer-events: none;
}
#apropos > .container { position: relative; z-index: 1; }

/* ===== BOT LATERAL DROIT (assistant) ===== */
.saysko-bot { position: fixed; right: 20px; bottom: 22px; z-index: 8000; display: flex; flex-direction: column; align-items: flex-end; gap: 10px; font-family: inherit; pointer-events: none; }
.bot-bubble {
  width: 320px; max-width: calc(100vw - 32px); max-height: 70vh; overflow: auto;
  background: rgba(13,12,15,0.97); border: 1px solid rgba(224,189,133,0.35);
  box-shadow: 0 24px 60px rgba(0,0,0,0.6); border-radius: 4px;
  transform: translateY(14px) scale(0.98); opacity: 0; pointer-events: none;
  transition: transform .28s cubic-bezier(.2,.8,.2,1), opacity .25s;
}
.saysko-bot.open .bot-bubble { transform: translateY(0) scale(1); opacity: 1; pointer-events: auto; } .bot-launch { pointer-events: auto; }
.bot-head { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-bottom: 1px solid rgba(224,189,133,0.18); }
.bot-avatar { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: #0b0b0d; font-weight: 700; font-size: .85rem; flex: 0 0 auto; }
.bot-head strong { display: block; font-size: .8rem; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text); }
.bot-head small { display: block; color: var(--accent); font-size: .65rem; letter-spacing: 1px; margin-top: 2px; }
.bot-close { margin-left: auto; background: none; border: 0; color: var(--muted); cursor: pointer; font-size: 1.1rem; line-height: 1; padding: 2px 6px; }
.bot-close:hover { color: var(--text); }
.bot-body { padding: 12px 14px; }
.bot-intro { color: var(--muted); font-size: .75rem; line-height: 1.7; margin: 0 0 10px; }
.bot-accordion { border-bottom: 1px solid rgba(255,255,255,.06); }
.bot-accordion:last-child { border-bottom: 0; }
.bot-q {
  width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 8px;
  background: none; border: 0; color: var(--text); cursor: pointer; text-align: left;
  padding: 10px 2px; font-size: .74rem; letter-spacing: .4px; font-family: inherit;
}
.bot-q::after { content: '+'; color: var(--accent); font-size: .9rem; transition: transform .2s; }
.bot-accordion.open .bot-q::after { transform: rotate(45deg); }
.bot-a { display: none; padding: 0 2px 12px; color: var(--muted); font-size: .73rem; line-height: 1.75; }
.bot-accordion.open .bot-a { display: block; animation: botFade .25s ease; }
.bot-a a { color: var(--accent); text-decoration: none; border-bottom: 1px solid rgba(224,189,133,.35); }
@keyframes botFade { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }
.bot-foot { padding: 10px 14px; border-top: 1px solid rgba(224,189,133,.18); color: var(--muted); font-size: .64rem; letter-spacing: .5px; }
.bot-launch {
  width: 52px; height: 52px; border-radius: 50%; cursor: pointer;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  border: 0; color: #0b0b0d; font-size: 1.4rem; font-weight: 700;
  box-shadow: 0 10px 30px rgba(0,0,0,.5); transition: transform .2s, box-shadow .2s;
}
.bot-launch:hover { transform: translateY(-3px) scale(1.05); box-shadow: 0 14px 34px rgba(224,189,133,.35); }
@media (max-width: 600px) { .saysko-bot { right: 14px; bottom: 14px; } }
</style>
